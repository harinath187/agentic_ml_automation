GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# Model availability changes over time and by account. If you get a
# "model_not_found" error, list what your key can actually access with:
#   python -c "from groq import Groq; import os; from dotenv import load_dotenv; load_dotenv(); [print(m.id) for m in Groq(api_key=os.environ['GROQ_API_KEY']).models.list().data]"

# --- Phase 9: production readiness (all optional, shown with their defaults) ---

# SQLite file for run/dataset metadata (api/db.py).
# APP_DB_PATH=reports/app.db

# Bounded background worker pool (api/job_queue.py).
# PIPELINE_MAX_WORKERS=2
# PIPELINE_MAX_QUEUED_RUNS=20

# Outer wall-clock safety net per run, in seconds (api/run_store.py) - on top
# of each run's own time_limit_s (which only bounds one AutoML .fit() call).
# PIPELINE_MAX_RUNTIME_S=3600

# Upload limits (api/main.py).
# MAX_UPLOAD_MB=200

# File cleanup (tools/file_cleanup.py) - uploads/reports/AutoGluon artifacts
# older than this are deleted; the cleanup loop runs this often.
# FILE_RETENTION_HOURS=168
# CLEANUP_INTERVAL_S=21600
